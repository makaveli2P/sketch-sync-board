{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": false,
    "incremental": false,
    "isolatedModules": false,
    "jsx": "preserve",
    "outDir": "build",
    "rootDir": ".",
    "plugins": []
  },
  "include": ["server/**/*.ts"],
  "exclude": ["node_modules", "build", "server/**/*.test.ts"]
}
