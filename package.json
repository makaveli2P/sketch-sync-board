{
  "name": "sketch-sync",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --exclude './.next/**' server/index.ts",
    "build": "npm run build:server && npm run build:next",
    "build:server": "tsc --project tsconfig.server.json",
    "build:next": "next build",
    "start": "NODE_ENV=production node build/server/index.js",
    "start:socket": "NODE_ENV=production node build/server/standalone.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit --project tsconfig.server.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "jotai": "^3.0.0",
    "motion": "^13.4.4",
    "next": "^16.4.6",
    "react": "^19.3.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-toastify": "^11.1.0",
    "react-use": "^17.6.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
